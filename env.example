# Токен от @BotFather (без него бот не запустится; на тесты не влияет)
TELEGRAM_BOT_TOKEN=
# Базовый адрес сайта «Альфа-Курс», из него строятся ссылки на материалы (без слэша в конце)
BASE_URL=https://example.com
# Строка подключения к БД (в compose переопределяется на сервис db)
DATABASE_URL=postgresql://postgres:pg@db:5432/courses
# Часовой пояс пользователей по умолчанию
BOT_TZ=Europe/Moscow
# Пароль Postgres в compose
POSTGRES_PASSWORD=pg
# Путь к файлу бэкапа на хосте (монтируется в контейнер Postgres только для чтения)
BACKUP_FILE=./data/alfa_course_hackathon.backup
